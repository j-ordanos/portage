# Copy to .env for local development.
# Generate a new 32-byte key: openssl rand -base64 32
MASTER_KEY=

# Generate with: pnpm hash-password "your-password"
ADMIN_PASSWORD_HASH=

DATA_DIR=./data
PORT=3001
PUBLIC_URL=
UPSTREAM_ALLOW_PRIVATE=true
UPSTREAM_ALLOWED_HOSTS=
LOG_LEVEL=info
RUN_RETENTION_DAYS=30
