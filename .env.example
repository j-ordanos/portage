# Everything here is optional. Portage runs with no environment variables at all.

# PORT=3000
# DATA_DIR=./data

# Seals saved tokens. If unset, a key is generated into DATA_DIR/master.key.
# Generate your own with:  openssl rand -base64 32
# MASTER_KEY=

# Set to false once your own account exists, to stop others signing up.
# ALLOW_SIGNUP=true

# Set to false on a public instance (blocks Coolify/Dokploy at private addresses).
# UPSTREAM_ALLOW_PRIVATE=true

# Your public address. Enables secure cookies.
# PUBLIC_URL=https://portage.example.com
