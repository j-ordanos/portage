{
  "name": "coolify-dokploy-migrator",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @migrator/server dev",
    "lint": "biome check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "hash-password": "pnpm --filter @migrator/server hash-password",
    "fixtures:sanitize": "node scripts/sanitize-fixtures.mjs",
    "fixtures:record": "node scripts/record-fixtures.mjs",
    "e2e:lab": "node scripts/e2e-lab.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@types/node": "24.0.10",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "argon2",
      "esbuild"
    ]
  }
}
